---
/**
 * StaticStmSetup.astro — 静的図(記事仕様書 14 §6.1 の S-2。S-1 はサムネイル)
 *
 * 走査トンネル顕微鏡の構成の模式: 圧電素子の走査機構、探針、試料、
 * 電流計とバイアス、フィードバック回路(電流 → 高さの修正)、高さの記録 = 像。
 * 信号の流れを矢印で示す。広い画面では横長、狭い画面では縦長の配置にする
 * (文字を小さくしすぎないため、SVG を 2 枚用意して CSS で切り替える)。
 * 色はすべて意味パレット・UI トークンの CSS 変数(直書きしない)。
 * 記事の中では最初の静的図なので、図注は「図S-1」とする。
 */

interface Props {
  caption: string;
  alt: string;
}

const { caption, alt } = Astro.props;

type Layout = "wide" | "narrow";

interface Geometry {
  viewBox: string;
  /** 圧電素子の矩形 */
  piezo: { x: number; y: number; w: number; h: number };
  /** 探針の先端(三角の頂点)と根元の中心・幅 */
  tip: { x: number; top: number; apex: number; w: number };
  /** 試料の原子の列 */
  sample: { x0: number; x1: number; y: number; r: number; step: number };
  /** 試料の土台の下端 */
  baseBottom: number;
  /** 回路の縦の線の x と、電流計・バイアスの y */
  wireX: number;
  meterY: number;
  biasY: number;
  /** フィードバック回路の箱 */
  fb: { x: number; y: number; w: number; h: number };
  /** 像の箱(左上と 1 マスの大きさ) */
  img: { x: number; y: number; cell: number };
}

const GEOMETRY: Record<Layout, Geometry> = {
  wide: {
    viewBox: "0 0 720 322",
    piezo: { x: 140, y: 24, w: 100, h: 62 },
    tip: { x: 190, top: 86, apex: 172, w: 46 },
    sample: { x0: 84, x1: 300, y: 222, r: 10, step: 24 },
    baseBottom: 258,
    wireX: 372,
    meterY: 150,
    biasY: 222,
    fb: { x: 440, y: 110, w: 196, h: 80 },
    img: { x: 612, y: 214, cell: 14 },
  },
  narrow: {
    viewBox: "0 0 360 572",
    piezo: { x: 56, y: 22, w: 104, h: 64 },
    tip: { x: 108, top: 86, apex: 166, w: 44 },
    sample: { x0: 24, x1: 200, y: 214, r: 10, step: 24 },
    baseBottom: 248,
    wireX: 276,
    meterY: 148,
    biasY: 214,
    fb: { x: 34, y: 312, w: 292, h: 78 },
    img: { x: 128, y: 450, cell: 20 },
  },
};

/** 像の模式(5×5 マス。高いところほど濃い) */
const IMAGE_LEVELS = [
  [0.85, 0.3, 0.85, 0.3, 0.85],
  [0.3, 0.1, 0.3, 0.1, 0.3],
  [0.85, 0.3, 0.85, 0.3, 0.85],
  [0.3, 0.1, 0.3, 0.1, 0.3],
  [0.85, 0.3, 0.85, 0.3, 0.85],
];

function sampleAtoms(g: Geometry): number[] {
  const xs: number[] = [];
  for (let x = g.sample.x0; x <= g.sample.x1 + 0.1; x += g.sample.step) {
    xs.push(x);
  }
  return xs;
}
---

<figure class="static-fig">
  <div class="static-fig-frame">
    {
      (["wide", "narrow"] as const).map((layout) => {
        const g = GEOMETRY[layout];
        const narrow = layout === "narrow";
        const atoms = sampleAtoms(g);
        const holderY = g.tip.top + 12;
        const fbMidY = g.fb.y + g.fb.h / 2;
        const imgSize = g.img.cell * 5;
        return (
          <svg
            class={`stm-setup-${layout}`}
            viewBox={g.viewBox}
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <defs>
              <marker
                id={`stm-head-${layout}`}
                viewBox="0 0 10 10"
                refX="8"
                refY="5"
                markerWidth="7"
                markerHeight="7"
                orient="auto-start-reverse"
              >
                <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--color-text-2)" />
              </marker>
              <marker
                id={`stm-beam-${layout}`}
                viewBox="0 0 10 10"
                refX="8"
                refY="5"
                markerWidth="6"
                markerHeight="6"
                orient="auto-start-reverse"
              >
                <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--mat-beam)" />
              </marker>
            </defs>

            {/* 圧電素子(x・y・z に動かす) */}
            <rect
              x={g.piezo.x}
              y={g.piezo.y}
              width={g.piezo.w}
              height={g.piezo.h}
              rx="8"
              fill="var(--mat-matrix)"
              fill-opacity="0.25"
              stroke="var(--mat-matrix)"
              stroke-width="1.5"
            />
            <text
              x={g.piezo.x + g.piezo.w / 2}
              y={g.piezo.y + 28}
              text-anchor="middle"
              font-size="14"
              font-weight="600"
              fill="var(--color-text)"
            >
              圧電素子
            </text>
            <text
              x={g.piezo.x + g.piezo.w / 2}
              y={g.piezo.y + 48}
              text-anchor="middle"
              font-size="12"
              fill="var(--color-text-2)"
            >
              x・y・z に動かす
            </text>

            {/* 探針 */}
            <rect
              x={g.tip.x - 10}
              y={g.piezo.y + g.piezo.h}
              width="20"
              height={holderY - g.piezo.y - g.piezo.h}
              fill="var(--mat-matrix)"
              fill-opacity="0.6"
            />
            <path
              d={`M ${g.tip.x - g.tip.w / 2} ${holderY} L ${g.tip.x + g.tip.w / 2} ${holderY} L ${g.tip.x} ${g.tip.apex} Z`}
              fill="var(--mat-matrix)"
            />
            <text
              x={g.tip.x - g.tip.w / 2 - 8}
              y={(holderY + g.tip.apex) / 2}
              text-anchor="end"
              font-size="13"
              fill="var(--color-text-2)"
            >
              探針
            </text>

            {/* 試料の原子と土台 */}
            <rect
              x={g.sample.x0 - 18}
              y={g.sample.y}
              width={g.sample.x1 - g.sample.x0 + 36}
              height={g.baseBottom - g.sample.y}
              fill="var(--mat-matrix)"
              fill-opacity="0.18"
            />
            {atoms.map((x) => (
              <circle
                cx={x}
                cy={g.sample.y}
                r={g.sample.r}
                fill="var(--mat-matrix)"
              />
            ))}
            <text
              x={narrow ? 24 : g.sample.x0 - 18}
              y={g.baseBottom + 18}
              font-size="13"
              fill="var(--color-text-2)"
            >
              試料
            </text>

            {/* トンネル電流(探針の先端 → 試料)とすき間 */}
            <line
              x1={g.tip.x}
              y1={g.tip.apex + 2}
              x2={g.tip.x}
              y2={g.sample.y - g.sample.r - 1}
              stroke="var(--mat-beam)"
              stroke-width="3"
              marker-end={`url(#stm-beam-${layout})`}
            />
            <text
              x={g.tip.x + 12}
              y={g.tip.apex + 14}
              font-size="12"
              fill="var(--mat-beam-ink)"
            >
              トンネル電流
            </text>
            <text
              x={g.tip.x + 12}
              y={g.tip.apex - 2}
              font-size="11"
              fill="var(--color-text-2)"
            >
              すき間 約 0.6 nm
            </text>

            {/* 回路: 探針 → 電流計 → バイアス → 試料 */}
            <path
              d={`M ${g.tip.x + 10} ${holderY - 8} H ${g.wireX} V ${g.meterY - 16} M ${g.wireX} ${g.meterY + 16} V ${g.biasY - 8} M ${g.wireX} ${g.biasY + 8} V ${g.baseBottom - 10} H ${g.sample.x1 + 18}`}
              fill="none"
              stroke="var(--color-text-2)"
              stroke-width="1.5"
            />
            <circle
              cx={g.wireX}
              cy={g.meterY}
              r="16"
              fill="var(--color-bg)"
              stroke="var(--color-text-2)"
              stroke-width="1.5"
            />
            <text
              x={g.wireX}
              y={g.meterY + 5}
              text-anchor="middle"
              font-size="15"
              font-weight="600"
              fill="var(--mat-beam-ink)"
            >
              I
            </text>
            <text
              x={g.wireX - 22}
              y={g.meterY + 5}
              text-anchor="end"
              font-size="12"
              fill="var(--color-text-2)"
            >
              電流計
            </text>
            {/* バイアス(電池の記号) */}
            <line
              x1={g.wireX - 14}
              y1={g.biasY - 8}
              x2={g.wireX + 14}
              y2={g.biasY - 8}
              stroke="var(--color-text-2)"
              stroke-width="2"
            />
            <line
              x1={g.wireX - 8}
              y1={g.biasY + 8}
              x2={g.wireX + 8}
              y2={g.biasY + 8}
              stroke="var(--color-text-2)"
              stroke-width="3"
            />
            {narrow ? (
              <g>
                <text
                  x={g.wireX + 20}
                  y={g.biasY - 2}
                  font-size="12"
                  fill="var(--color-text-2)"
                >
                  バイアス
                </text>
                <text
                  x={g.wireX + 20}
                  y={g.biasY + 14}
                  font-size="12"
                  fill="var(--color-text-2)"
                >
                  約 0.5 V
                </text>
              </g>
            ) : (
              <text
                x={g.wireX + 22}
                y={g.biasY + 5}
                font-size="12"
                fill="var(--color-text-2)"
              >
                バイアス(約 0.5 V)
              </text>
            )}

            {/* フィードバック回路 */}
            <rect
              x={g.fb.x}
              y={g.fb.y}
              width={g.fb.w}
              height={g.fb.h}
              rx="8"
              fill="none"
              stroke="var(--color-text-2)"
              stroke-width="1.2"
            />
            <text
              x={g.fb.x + g.fb.w / 2}
              y={g.fb.y + 26}
              text-anchor="middle"
              font-size="14"
              font-weight="600"
              fill="var(--color-text)"
            >
              フィードバック回路
            </text>
            <text
              x={g.fb.x + g.fb.w / 2}
              y={g.fb.y + 47}
              text-anchor="middle"
              font-size="12"
              fill="var(--color-text-2)"
            >
              電流を設定値と比べて
            </text>
            <text
              x={g.fb.x + g.fb.w / 2}
              y={g.fb.y + 64}
              text-anchor="middle"
              font-size="12"
              fill="var(--color-text-2)"
            >
              高さ z の直し方を決める
            </text>

            {/* 信号: 電流計 → フィードバック回路 */}
            {narrow ? (
              <line
                x1={g.wireX}
                y1={g.baseBottom - 10}
                x2={g.wireX}
                y2={g.fb.y - 4}
                stroke="var(--color-text-2)"
                stroke-width="1.5"
                stroke-dasharray="5 4"
                marker-end={`url(#stm-head-${layout})`}
              />
            ) : (
              <line
                x1={g.wireX + 16}
                y1={g.meterY}
                x2={g.fb.x - 4}
                y2={g.meterY}
                stroke="var(--color-text-2)"
                stroke-width="1.5"
                stroke-dasharray="5 4"
                marker-end={`url(#stm-head-${layout})`}
              />
            )}
            <text
              x={narrow ? g.wireX + 8 : (g.wireX + g.fb.x) / 2 + 6}
              y={narrow ? (g.baseBottom + g.fb.y) / 2 + 4 : g.meterY - 8}
              text-anchor={narrow ? "start" : "middle"}
              font-size="12"
              fill="var(--color-text-2)"
            >
              電流 I
            </text>

            {/* 信号: フィードバック回路 → 圧電素子の高さ z */}
            {narrow ? (
              <path
                d={`M ${g.fb.x} ${fbMidY} H 14 V ${g.piezo.y + g.piezo.h / 2} H ${g.piezo.x - 4}`}
                fill="none"
                stroke="var(--color-text-2)"
                stroke-width="1.5"
                stroke-dasharray="5 4"
                marker-end={`url(#stm-head-${layout})`}
              />
            ) : (
              <path
                d={`M ${g.fb.x + g.fb.w / 2} ${g.fb.y} V ${g.piezo.y + 22} H ${g.piezo.x + g.piezo.w + 4}`}
                fill="none"
                stroke="var(--color-text-2)"
                stroke-width="1.5"
                stroke-dasharray="5 4"
                marker-end={`url(#stm-head-${layout})`}
              />
            )}
            <text
              x={narrow ? 24 : g.piezo.x + g.piezo.w + 14}
              y={narrow ? g.baseBottom + 44 : g.piezo.y + 14}
              font-size="12"
              fill="var(--color-text-2)"
            >
              高さ z を直す
            </text>

            {/* 記録: 高さ z の地図 = 像 */}
            {narrow ? (
              <line
                x1={g.fb.x + g.fb.w / 2}
                y1={g.fb.y + g.fb.h}
                x2={g.fb.x + g.fb.w / 2}
                y2={g.img.y - 6}
                stroke="var(--color-text-2)"
                stroke-width="1.5"
                stroke-dasharray="5 4"
                marker-end={`url(#stm-head-${layout})`}
              />
            ) : (
              <path
                d={`M ${g.fb.x + g.fb.w - 30} ${g.fb.y + g.fb.h} V ${g.img.y + imgSize / 2} H ${g.img.x - 6}`}
                fill="none"
                stroke="var(--color-text-2)"
                stroke-width="1.5"
                stroke-dasharray="5 4"
                marker-end={`url(#stm-head-${layout})`}
              />
            )}
            {IMAGE_LEVELS.map((row, r) =>
              row.map((level, c) => (
                <rect
                  x={g.img.x + c * g.img.cell}
                  y={g.img.y + r * g.img.cell}
                  width={g.img.cell}
                  height={g.img.cell}
                  fill="var(--mat-matrix)"
                  fill-opacity={level}
                />
              )),
            )}
            <rect
              x={g.img.x}
              y={g.img.y}
              width={imgSize}
              height={imgSize}
              fill="none"
              stroke="var(--color-hairline)"
              stroke-width="1"
            />
            <text
              x={g.img.x + imgSize / 2}
              y={g.img.y - 10}
              text-anchor="middle"
              font-size="12"
              fill="var(--color-text-2)"
              display={narrow ? "none" : undefined}
            >
              像
            </text>
            <text
              x={narrow ? g.img.x + imgSize + 12 : g.img.x + imgSize / 2}
              y={narrow ? g.img.y + imgSize / 2 - 4 : g.img.y + imgSize + 20}
              text-anchor={narrow ? "start" : "middle"}
              font-size="12"
              fill="var(--color-text-2)"
            >
              z の記録 = 像
            </text>
            {narrow && (
              <text
                x={g.img.x + imgSize + 12}
                y={g.img.y + imgSize / 2 + 14}
                font-size="11"
                fill="var(--color-text-2)"
              >
                (高いほど濃い)
              </text>
            )}
          </svg>
        );
      })
    }
  </div>
  <figcaption>{caption}</figcaption>
  <p class="sr-only">{alt}</p>
</figure>

<style>
  .stm-setup-narrow {
    display: none;
  }

  @media (max-width: 600px) {
    .stm-setup-wide {
      display: none;
    }

    .stm-setup-narrow {
      display: block;
    }
  }
</style>
