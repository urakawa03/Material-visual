---
/**
 * KirkendallS2.astro — 静的図 S-2(記事仕様書 06 §6)
 *
 * 空孔の生成・消滅サイト(転位・粒界)が働くと、格子面が 1 枚減る/増える。
 * これが「格子面そのものが動く」= ラティスシフトの微視的な中身である。
 *
 * 色: 格子面 = --mat-matrix、転位(⊥)= --mat-defect、空孔 = 塗りなし +
 * --mat-matrix の破線縁(全記事共通の約束)、目印 = --color-accent。
 */

interface Props {
  caption: string;
  alt: string;
}

const { caption, alt } = Astro.props;

const PANEL_W = 300;
const PANEL_X = [10, 326];
const TOP = 46;
const BOT = 150;
/** 格子面(縦線)の本数と間隔 */
const PLANES = 9;
const SPACING = 26;
const FIRST = 40;

interface Panel {
  x: number;
  title: string;
  /** 消える(シンク)か 増える(ソース)か */
  kind: "sink" | "source";
  note: string;
}

const panels: Panel[] = [
  {
    x: PANEL_X[0],
    title: "空孔を飲み込む(シンク)",
    kind: "sink",
    note: "格子面が 1 枚減る → 格子は左へ詰まる",
  },
  {
    x: PANEL_X[1],
    title: "空孔を吐き出す(ソース)",
    kind: "source",
    note: "格子面が 1 枚増える → 格子は右へ広がる",
  },
];

/** ⊥ 記号のパス(転位) */
function teePath(x: number, y: number, s: number): string {
  return `M ${x - s / 2} ${y} H ${x + s / 2} M ${x} ${y} V ${y - s * 0.8}`;
}
---

<figure class="static-fig">
  <svg
    viewBox="0 0 636 210"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    {
      panels.map((p) => {
        const removedIndex = 5;
        return (
          <g>
            {/* 格子面(縦線)。シンク側は 1 枚が消えかけ(破線)、ソース側は 1 枚が生まれかけ */}
            {Array.from({ length: PLANES }, (_, i) => {
              const x = p.x + FIRST + i * SPACING;
              const ghost =
                (p.kind === "sink" && i === removedIndex) ||
                (p.kind === "source" && i === removedIndex);
              return (
                <line
                  x1={x}
                  y1={TOP}
                  x2={x}
                  y2={BOT}
                  stroke="var(--mat-matrix)"
                  stroke-width={ghost ? 2 : 1.8}
                  stroke-dasharray={ghost ? "4 4" : undefined}
                  opacity={ghost ? 0.9 : 1}
                />
              );
            })}
            {/* 転位(⊥)= 空孔のソース/シンク */}
            <path
              d={teePath(p.x + FIRST + removedIndex * SPACING, BOT + 14, 20)}
              stroke="var(--mat-defect)"
              stroke-width="2.5"
              fill="none"
              stroke-linecap="round"
            />
            {/* 空孔(塗りなし + 破線縁)と、その出入りの矢印 */}
            <circle
              cx={p.x + FIRST + removedIndex * SPACING}
              cy={p.kind === "sink" ? TOP + 30 : TOP + 30}
              r="9"
              fill="none"
              stroke="var(--mat-matrix)"
              stroke-width="1.5"
              stroke-dasharray="3 2.5"
            />
            <g stroke="var(--color-text-2)" stroke-width="2" fill="none">
              {p.kind === "sink" ? (
                <line
                  x1={p.x + FIRST + removedIndex * SPACING}
                  y1={TOP + 44}
                  x2={p.x + FIRST + removedIndex * SPACING}
                  y2={BOT + 2}
                />
              ) : (
                <line
                  x1={p.x + FIRST + removedIndex * SPACING}
                  y1={BOT + 2}
                  x2={p.x + FIRST + removedIndex * SPACING}
                  y2={TOP + 44}
                />
              )}
            </g>
            <path
              d={
                p.kind === "sink"
                  ? `M ${p.x + FIRST + removedIndex * SPACING} ${BOT + 6} l -4 -8 h 8 Z`
                  : `M ${p.x + FIRST + removedIndex * SPACING} ${TOP + 40} l -4 8 h 8 Z`
              }
              fill="var(--color-text-2)"
            />
            {/* 格子に固定された目印と、格子の移動方向 */}
            <line
              x1={p.x + FIRST + 7 * SPACING}
              y1={TOP - 8}
              x2={p.x + FIRST + 7 * SPACING}
              y2={BOT + 8}
              stroke="var(--color-accent)"
              stroke-width="3"
            />
            <g
              stroke="var(--color-accent)"
              stroke-width="2"
              fill="var(--color-accent)"
            >
              <line
                x1={p.x + FIRST + 7 * SPACING}
                y1={TOP - 11}
                x2={p.x + FIRST + 7 * SPACING + (p.kind === "sink" ? -22 : 22)}
                y2={TOP - 11}
              />
              <path
                d={
                  p.kind === "sink"
                    ? `M ${p.x + FIRST + 7 * SPACING - 26} ${TOP - 11} l 7 -4 v 8 Z`
                    : `M ${p.x + FIRST + 7 * SPACING + 26} ${TOP - 11} l -7 -4 v 8 Z`
                }
              />
            </g>
            {/* ラベル */}
            <text
              x={p.x + PANEL_W / 2}
              y="18"
              text-anchor="middle"
              font-size="13.5"
              font-weight="600"
              fill="var(--color-text)"
            >
              {p.title}
            </text>
            <text
              x={p.x + PANEL_W / 2}
              y="198"
              text-anchor="middle"
              font-size="12.5"
              fill="var(--color-text-2)"
            >
              {p.note}
            </text>
            <text
              x={p.x + FIRST + 7 * SPACING}
              y={BOT + 26}
              text-anchor="middle"
              font-size="12"
              fill="var(--color-accent)"
            >
              目印
            </text>
          </g>
        );
      })
    }
  </svg>
  <figcaption>{caption}</figcaption>
  <p class="sr-only">{alt}</p>
</figure>
