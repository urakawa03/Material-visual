---
/**
 * StaticDash.astro — 静的図 S-3(記事仕様書 02 §6)
 * Dash のシリコン実験の模式図: 銅デコレーション + 赤外線観察で見えた
 * 同心ループの再描画。※実写真の転載はしない(§6)。
 */
interface Props {
  caption: string;
}
const { caption } = Astro.props;
---

<figure class="static-fig">
  <div class="static-fig-frame">
    <svg
      viewBox="0 0 720 300"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Dash によるシリコン中のフランク・リード源の観察の模式図。シリコン結晶の薄片の中に、中央の源の線分を取り囲む同心状の転位ループが並び、銅で飾られた転位が赤外線で観察されたことが示されている。"
    >
      {/* シリコン薄片 */}
      <g transform="translate(70 40)">
        <rect
          x="0"
          y="0"
          width="420"
          height="220"
          rx="10"
          fill="none"
          stroke="var(--color-hairline)"
          stroke-width="2"></rect>
        <text x="10" y="-10" font-size="13" fill="var(--color-text-2)"
          >シリコン単結晶の薄片</text
        >
        {/* 同心ループ(銅デコレーションで可視化された転位) */}
        <g
          fill="none"
          stroke="var(--mat-defect)"
          stroke-dasharray="1.5 5"
          stroke-linecap="round"
        >
          <ellipse cx="210" cy="110" rx="180" ry="86" stroke-width="4"
          ></ellipse>
          <ellipse cx="210" cy="110" rx="140" ry="66" stroke-width="4"
          ></ellipse>
          <ellipse cx="210" cy="110" rx="100" ry="47" stroke-width="4"
          ></ellipse>
          <ellipse cx="210" cy="110" rx="62" ry="29" stroke-width="4"></ellipse>
        </g>
        {/* 中央の源 */}
        <line
          x1="176"
          y1="110"
          x2="244"
          y2="110"
          stroke="var(--mat-defect)"
          stroke-width="3"></line>
        <circle cx="176" cy="110" r="4.5" fill="var(--mat-precip)"></circle>
        <circle cx="244" cy="110" r="4.5" fill="var(--mat-precip)"></circle>
        <text
          x="210"
          y="136"
          text-anchor="middle"
          font-size="12.5"
          fill="var(--color-text-2)">源</text
        >
      </g>
      {/* 注記 */}
      <g transform="translate(530 70)">
        <circle cx="8" cy="4" r="4" fill="var(--mat-solute)"></circle>
        <circle cx="20" cy="10" r="3" fill="var(--mat-solute)"></circle>
        <circle cx="13" cy="17" r="3.4" fill="var(--mat-solute)"></circle>
        <text x="34" y="8" font-size="13" fill="var(--color-text)"
          >銅を転位に析出させて</text
        >
        <text x="34" y="26" font-size="13" fill="var(--color-text)"
          >「飾る」(デコレーション)</text
        >
        <text x="0" y="66" font-size="13" fill="var(--color-text)"
          >シリコンは赤外線に透明</text
        >
        <text x="0" y="84" font-size="13" fill="var(--color-text)"
          >→ 内部の転位が透けて見える</text
        >
        <text x="0" y="122" font-size="12.5" fill="var(--color-text-2)"
          >放出済みのループが同心状に</text
        >
        <text x="0" y="140" font-size="12.5" fill="var(--color-text-2)"
          >並ぶ(図5 と同じ幾何)</text
        >
      </g>
    </svg>
  </div>
  <figcaption>{caption}</figcaption>
</figure>
