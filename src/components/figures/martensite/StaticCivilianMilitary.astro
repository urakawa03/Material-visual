---
/**
 * StaticCivilianMilitary.astro — 静的図 S-2(記事仕様書 10 §6.1)
 *
 * 拡散変態と無拡散変態の古典的な比喩(「民間人型」と「軍隊型」)の 2 コマ。
 * - 左: 拡散変態。炭素(--mat-solute)はそれぞれ勝手に長い距離を歩いて集まり、
 *   炭化物(--mat-precip)になる。隣の相手は入れ替わる。時間がかかる。
 * - 右: 無拡散変態。格子全体が号令で一斉にせん断され、どの原子も隣との
 *   関係(結合の線)を保つ。炭素はその場に閉じ込められたまま運ばれる。
 * 色は CSS 変数(§6.2)。原子の縁取り(約 20% 暗い同系色 — §6.5)だけは
 * darken() でビルド時に確定する(コットレル雰囲気の静的図と同じ方法)。
 */
import { darken, matColor } from "../../../core/colors";

interface Props {
  caption: string;
  alt: string;
}

const { caption, alt } = Astro.props;

const FE_EDGE = darken(matColor("matrix"));
const C_EDGE = darken(matColor("solute"));
const PPT_EDGE = darken(matColor("precip"));

const r1 = (v: number): number => Math.round(v * 10) / 10;

/** 格子の大きさ(両パネル共通) */
const COLS = 6;
const ROWS = 4;
const SP = 38;
const R_FE = 8.5;
const R_C = 5;
const TOP = 74;

/* ---------------------------------------------------- 左: 拡散変態 */
const LX = 44;
const leftFe: Array<{ x: number; y: number }> = [];
for (let j = 0; j < ROWS; j++) {
  for (let i = 0; i < COLS; i++) {
    leftFe.push({ x: LX + i * SP, y: TOP + j * SP });
  }
}
/** 隙間(セルの中心)の座標 */
const gap = (i: number, j: number): { x: number; y: number } => ({
  x: LX + (i + 0.5) * SP,
  y: TOP + (j + 0.5) * SP,
});
/** 炭素の歩いた跡(隙間から隙間へ。最後は右下の炭化物へ集まる) */
const walks: Array<Array<[number, number]>> = [
  [
    [0, 0],
    [1, 0],
    [1, 1],
    [2, 1],
    [3, 1],
    [3, 2],
  ],
  [
    [0, 2],
    [1, 2],
    [2, 2],
    [2, 1],
    [3, 1],
    [3, 2],
  ],
  [
    [4, 0],
    [3, 0],
    [3, 1],
    [4, 1],
    [4, 2],
  ],
];
const walkPaths = walks.map((w) =>
  w
    .map(([i, j], k) => {
      const p = gap(i, j);
      return `${k === 0 ? "M" : "L"} ${r1(p.x)} ${r1(p.y)}`;
    })
    .join(" "),
);
const walkStarts = walks.map((w) => gap(w[0][0], w[0][1]));
/** 炭化物(右下に集まった塊)。そこにあった鉄原子は描かない(新しい相になった) */
const carbide = gap(3.6, 2.15);
const leftFeShown = leftFe.filter(
  (p) => Math.hypot(p.x - carbide.x, p.y - carbide.y) > 24,
);

/* -------------------------------------------------- 右: 無拡散変態 */
const RX = 380;
const SHEAR = 0.36;
const bottomY = TOP + (ROWS - 1) * SP;
const sheared = (x: number, y: number): { x: number; y: number } => ({
  x: x + SHEAR * (bottomY - y),
  y,
});
const rightRef: Array<{ x: number; y: number }> = [];
const rightNew: Array<{ x: number; y: number }> = [];
for (let j = 0; j < ROWS; j++) {
  for (let i = 0; i < COLS; i++) {
    const x = RX + i * SP;
    const y = TOP + j * SP;
    rightRef.push({ x, y });
    rightNew.push(sheared(x, y));
  }
}
const idx = (i: number, j: number): number => j * COLS + i;
/** 結合(右と下の隣) — せん断後も同じ相手どうしを結ぶ */
const bonds: Array<[number, number]> = [];
for (let j = 0; j < ROWS; j++) {
  for (let i = 0; i < COLS; i++) {
    if (i + 1 < COLS) bonds.push([idx(i, j), idx(i + 1, j)]);
    if (j + 1 < ROWS) bonds.push([idx(i, j), idx(i, j + 1)]);
  }
}
/** 炭素(隙間に入ったまま運ばれる) */
const rightCarbonRef = [
  { x: RX + 0.5 * SP, y: TOP + 0.5 * SP },
  { x: RX + 3.5 * SP, y: TOP + 1.5 * SP },
  { x: RX + 1.5 * SP, y: TOP + 2.5 * SP },
];
const rightCarbon = rightCarbonRef.map((p) => sheared(p.x, p.y));
/** 矢印(各行の右端の原子の移動) */
const arrows = [0, 1, 2].map((j) => ({
  from: rightRef[idx(COLS - 1, j)],
  to: rightNew[idx(COLS - 1, j)],
}));
---

<figure class="static-fig">
  <svg
    viewBox="0 0 640 300"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <marker
        id="mart-s2-arrow"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 Z" fill="var(--color-accent)"></path>
      </marker>
    </defs>

    <!-- 左: 拡散変態(民間人型) -->
    <g>
      <text
        x="140"
        y="26"
        text-anchor="middle"
        font-size="14"
        font-weight="600"
        fill="var(--color-text)">拡散変態(民間人型)</text
      >
      <text
        x="140"
        y="45"
        text-anchor="middle"
        font-size="12"
        fill="var(--color-text-2)">一人ひとりが勝手に歩いて並び替わる</text
      >
      {
        leftFeShown.map((p) => (
          <circle
            cx={p.x}
            cy={p.y}
            r={R_FE}
            fill="var(--mat-matrix)"
            stroke={FE_EDGE}
            stroke-width="1.5"
          />
        ))
      }
      {
        walkPaths.map((d) => (
          <path
            d={d}
            fill="none"
            stroke="var(--mat-solute)"
            stroke-width="2"
            stroke-dasharray="4 3"
            opacity="0.85"
          />
        ))
      }
      {
        walkStarts.map((p) => (
          <circle
            cx={p.x}
            cy={p.y}
            r={R_C}
            fill="none"
            stroke={C_EDGE}
            stroke-width="1.2"
            stroke-dasharray="2 2"
          />
        ))
      }
      <!-- 集まってできた炭化物 -->
      <ellipse
        cx={carbide.x}
        cy={carbide.y}
        rx="19"
        ry="13"
        fill="var(--mat-precip)"
        opacity="0.85"
        stroke={PPT_EDGE}
        stroke-width="1.5"></ellipse>
      <text
        x={carbide.x}
        y={carbide.y + 34}
        text-anchor="middle"
        font-size="11.5"
        fill="var(--color-text-2)">炭化物</text
      >
      <text
        x="140"
        y="248"
        text-anchor="middle"
        font-size="12.5"
        fill="var(--color-text)">炭素は長い距離を歩いて集まる</text
      >
      <text
        x="140"
        y="268"
        text-anchor="middle"
        font-size="12"
        fill="var(--color-text-2)">隣の相手は入れ替わる。時間がかかる</text
      >
    </g>

    <line
      x1="320"
      y1="18"
      x2="320"
      y2="280"
      stroke="var(--color-hairline)"
      stroke-width="1"></line>

    <!-- 右: 無拡散変態(軍隊型) -->
    <g>
      <text
        x="500"
        y="26"
        text-anchor="middle"
        font-size="14"
        font-weight="600"
        fill="var(--color-text)">無拡散変態(軍隊型)</text
      >
      <text
        x="500"
        y="45"
        text-anchor="middle"
        font-size="12"
        fill="var(--color-text-2)">号令で隊列ごと一斉に向きを変える</text
      >
      <!-- 変形前の位置(破線の輪郭) -->
      {
        rightRef.map((p) => (
          <circle
            cx={p.x}
            cy={p.y}
            r={R_FE}
            fill="none"
            stroke="var(--mat-matrix)"
            stroke-width="1"
            stroke-dasharray="2.5 2.5"
            opacity="0.8"
          />
        ))
      }
      <!-- 結合(同じ相手どうしのまま) -->
      {
        bonds.map(([a, b]) => (
          <line
            x1={r1(rightNew[a].x)}
            y1={rightNew[a].y}
            x2={r1(rightNew[b].x)}
            y2={rightNew[b].y}
            stroke="var(--color-text-2)"
            stroke-width="1.2"
            opacity="0.7"
          />
        ))
      }
      {
        rightNew.map((p) => (
          <circle
            cx={r1(p.x)}
            cy={p.y}
            r={R_FE}
            fill="var(--mat-matrix)"
            stroke={FE_EDGE}
            stroke-width="1.5"
          />
        ))
      }
      {
        rightCarbon.map((p) => (
          <circle
            cx={r1(p.x)}
            cy={p.y}
            r={R_C}
            fill="var(--mat-solute)"
            stroke={C_EDGE}
            stroke-width="1.2"
          />
        ))
      }
      {
        arrows.map((a) => (
          <line
            x1={r1(a.from.x + 12)}
            y1={a.from.y}
            x2={r1(a.to.x + 12)}
            y2={a.to.y}
            stroke="var(--color-accent)"
            stroke-width="2"
            marker-end="url(#mart-s2-arrow)"
          />
        ))
      }
      <text
        x="500"
        y="248"
        text-anchor="middle"
        font-size="12.5"
        fill="var(--color-text)">全員が隣との関係を保ったまま動く</text
      >
      <text
        x="500"
        y="268"
        text-anchor="middle"
        font-size="12"
        fill="var(--color-text-2)"
        >炭素はその場に閉じ込められる。一瞬で進む</text
      >
    </g>
  </svg>
  <figcaption>{caption}</figcaption>
  <p class="sr-only">{alt}</p>
</figure>
