---
/**
 * StaticVycor.astro — 静的図 S-2(記事仕様書 09 §6.1・S7 の挿図)
 *
 * 分相ガラスから多孔質ガラスを作る 3 段階(バイコールガラスの製法の模式):
 * ① 一様なガラス → ② 熱処理で分相(迷路)→ ③ 一方の相を酸で溶かして多孔質に。
 *
 * ②③ の迷路は手描きせず、図版と同じカーン・ヒリアード方程式(半陰的
 * スペクトル法)の解をビルド時に計算し、等高線を SVG の path にしたもの。
 * 色は図版と同じ: --mat-matrix(シリカに富む相)・--mat-second(ホウ酸ナトリウムに
 * 富む相)。溶かした後の穴は塗らない(白 + 細い線)。
 */
import { CahnHilliard } from "../../../widgets/spinodal-decomposition/lib/cahnhilliard";
import { contourPath } from "../../../widgets/spinodal-decomposition/lib/contour";

interface Props {
  caption: string;
  alt: string;
}

const { caption, alt } = Astro.props;

/** 計算格子(64²)・組成(ホウ酸ナトリウムに富む相の側がやや少ない)・時間(迷路が粗くなる前) */
const N = 64;
const sim = new CahnHilliard({ nx: N, ny: N, chi: 3 });
sim.initUniform(0.44, 0.02, 1938);
sim.step(150);

const W = 636;
const H = 262;
const SIDE = 150;
const TOP = 30;
const XS = [24, 243, 462] as const;
const d2 = contourPath(sim.c, N, 0.5, XS[1], TOP, SIDE);
const d3 = contourPath(sim.c, N, 0.5, XS[2], TOP, SIDE);
const MIX = "color-mix(in srgb, var(--mat-matrix) 56%, var(--mat-second))";
---

<figure class="static-fig">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <clipPath id="vycor-clip-2">
        <rect x={XS[1]} y={TOP} width={SIDE} height={SIDE}></rect>
      </clipPath>
      <clipPath id="vycor-clip-3">
        <rect x={XS[2]} y={TOP} width={SIDE} height={SIDE}></rect>
      </clipPath>
    </defs>

    <!-- ① 一様なガラス -->
    <rect x={XS[0]} y={TOP} width={SIDE} height={SIDE} fill={MIX} opacity="0.75"
    ></rect>
    <text
      x={XS[0] + SIDE / 2}
      y={TOP - 10}
      text-anchor="middle"
      font-size="13"
      font-weight="600"
      fill="var(--color-text)">① 一様なガラス</text
    >
    <text
      x={XS[0] + SIDE / 2}
      y={TOP + SIDE + 20}
      text-anchor="middle"
      font-size="12"
      fill="var(--color-text-2)"
      >溶かして冷やしたまま<tspan x={XS[0] + SIDE / 2} dy="16"
        >(Na₂O–B₂O₃–SiO₂ 系)</tspan
      ></text
    >

    <!-- ② 熱処理で分相 -->
    <g clip-path="url(#vycor-clip-2)">
      <rect
        x={XS[1]}
        y={TOP}
        width={SIDE}
        height={SIDE}
        fill="var(--mat-matrix)"
        opacity="0.55"></rect>
      <path d={d2} fill="var(--mat-second)" fill-rule="evenodd" opacity="0.9"
      ></path>
    </g>
    <text
      x={XS[1] + SIDE / 2}
      y={TOP - 10}
      text-anchor="middle"
      font-size="13"
      font-weight="600"
      fill="var(--color-text)">② 熱処理で分相</text
    >
    <text
      x={XS[1] + SIDE / 2}
      y={TOP + SIDE + 20}
      text-anchor="middle"
      font-size="12"
      fill="var(--color-text-2)"
      >500 °C 前後に保つと<tspan x={XS[1] + SIDE / 2} dy="16"
        >2 相が迷路状に絡み合う</tspan
      ></text
    >

    <!-- ③ 酸で一方の相を溶かす -->
    <g clip-path="url(#vycor-clip-3)">
      <rect
        x={XS[2]}
        y={TOP}
        width={SIDE}
        height={SIDE}
        fill="var(--mat-matrix)"
        opacity="0.55"></rect>
      <path
        d={d3}
        fill="var(--color-bg)"
        fill-rule="evenodd"
        stroke="var(--mat-matrix)"
        stroke-width="1"></path>
    </g>
    <text
      x={XS[2] + SIDE / 2}
      y={TOP - 10}
      text-anchor="middle"
      font-size="13"
      font-weight="600"
      fill="var(--color-text)">③ 酸で一方を溶かす</text
    >
    <text
      x={XS[2] + SIDE / 2}
      y={TOP + SIDE + 20}
      text-anchor="middle"
      font-size="12"
      fill="var(--color-text-2)"
      >シリカの骨格だけが残り<tspan x={XS[2] + SIDE / 2} dy="16"
        >つながった細孔が通る</tspan
      ></text
    >

    <!-- 段階の矢印 -->
    {
      [0, 1].map((k) => {
        const x0 = XS[k] + SIDE + 10;
        const x1 = XS[k + 1] - 12;
        const y = TOP + SIDE / 2;
        return (
          <g>
            <line
              x1={x0}
              y1={y}
              x2={x1 - 7}
              y2={y}
              stroke="var(--color-text-2)"
              stroke-width="2"
            />
            <path
              d={`M ${x1} ${y} L ${x1 - 9} ${y - 5} L ${x1 - 9} ${y + 5} Z`}
              fill="var(--color-text-2)"
            />
          </g>
        );
      })
    }

    <!-- 凡例 -->
    <g font-size="12" fill="var(--color-text-2)">
      <rect
        x="24"
        y={H - 26}
        width="14"
        height="14"
        fill="var(--mat-matrix)"
        opacity="0.55"></rect>
      <text x="44" y={H - 14}>シリカ(SiO₂)に富む相</text>
      <rect
        x="210"
        y={H - 26}
        width="14"
        height="14"
        fill="var(--mat-second)"
        opacity="0.9"></rect>
      <text x="230" y={H - 14}>ホウ酸ナトリウムに富む相</text>
      <rect
        x="420"
        y={H - 26}
        width="14"
        height="14"
        fill="var(--color-bg)"
        stroke="var(--mat-matrix)"></rect>
      <text x="440" y={H - 14}>溶かした後の穴</text>
    </g>
  </svg>
  <figcaption>{caption}</figcaption>
  <p class="sr-only">{alt}</p>
</figure>
