---
/**
 * M.astro — KaTeX 数式(仕様書 §7.5)
 *
 * ビルド時に renderToString で HTML 化し、クライアントには HTML +
 * KaTeX CSS のみを配信する(クライアント JS ゼロ)。
 *
 * 数式中の変数を意味パレット(§6.2)の色で塗るマクロ(1 引数):
 *   \mmat{a}   母相     \msol{C}  溶質     \msec{B}   第二元素
 *   \mdef{U}   欠陥     \mppt{r}  析出物   \mbeam{k}  ビーム
 *   \mrecip{g} 逆格子点
 * (対応する CSS クラス .mx-* は base.css に定義)
 *
 * 使い方: インライン <M tex="…" />、別行立て <M block tex="…" />
 */
import katex from "katex";
import "katex/dist/katex.min.css";

interface Props {
  /** LaTeX ソース */
  tex: string;
  /** true で別行立て(display mode) */
  block?: boolean;
}

const { tex, block = false } = Astro.props;

/** 意味パレットで変数を塗るためのマクロ(class ベース — §7.5) */
const COLOR_MACROS: Record<string, string> = {
  "\\mmat": "\\htmlClass{mx-mat}{#1}",
  "\\msol": "\\htmlClass{mx-sol}{#1}",
  "\\msec": "\\htmlClass{mx-sec}{#1}",
  "\\mdef": "\\htmlClass{mx-def}{#1}",
  "\\mppt": "\\htmlClass{mx-ppt}{#1}",
  "\\mbeam": "\\htmlClass{mx-beam}{#1}",
  "\\mrecip": "\\htmlClass{mx-recip}{#1}",
};

const html = katex.renderToString(tex, {
  displayMode: block,
  throwOnError: true,
  macros: COLOR_MACROS,
  // \htmlClass だけを信頼する(任意の HTML 挿入は許可しない)
  trust: (context) => context.command === "\\htmlClass",
  strict: (errorCode: string) =>
    errorCode === "htmlExtension" ? "ignore" : "warn",
});
---

<Fragment set:html={html} />
